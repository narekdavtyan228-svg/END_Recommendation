# Copy to .env and fill in. Secrets are NOT stored here: *_FILE variables point to secret files.
# Who sets what: see the table in README.md (DevOps / ИБ / разработка).

# --- required ---
DATABASE_URL_FILE=/run/secrets/database_url        # postgresql://aicheck_app:...@host:5432/aicheck?sslmode=verify-full
ORG_CODE=OMG
LLM_BASE_URL=https://llm.internal.example           # local OpenAI-compatible gateway; /v1/chat/completions is appended
LLM_API_KEY_FILE=/run/secrets/llm_api_key
LLM_MODEL=deepseek-v4-flash
JWT_ISSUER=https://idp.example
JWT_AUDIENCE=ai-check
JWT_PUBLIC_KEY_FILE=/run/secrets/jwt_public_key.pem
ALLOWED_OUTBOUND_HOSTS=llm.internal.example,hse.internal.example
HSE_CATALOG_EXPORT_URL=https://hse.internal.example/internal/catalog/export
HSE_CALLBACK_URL=https://hse.internal.example/internal/ai-check/callback
CALLBACK_HMAC_SECRET_FILE=/run/secrets/callback_hmac_secret

# --- optional (defaults in brackets) ---
LLM_TIMEOUT_S=12
LLM_JSON_MODE=true                  # false if the model does not support response_format
LLM_JSON_SCHEMA_MODE=false
LLM_MIN_CONFIDENCE=0.6
# LLM_CA_BUNDLE=/etc/ssl/internal-ca.pem
# LLM_MODEL_ALT=qwen-...            # only for `compare-models`
PROMPT_VERSION=v1
MAX_BODY_KB=256
POLL_INTERVAL_S=1
LOG_LEVEL=INFO
KB_MAX_FILE_MB=20
KB_CONTEXT_CHARS=12000
KB_FTS_LIMIT=8
USER_RUNS_PER_HOUR=30

# --- mode A (the front calls the service with a user token) ---
# IDP_JWKS_URL=https://idp.example/.well-known/jwks.json
# IDP_ISSUER=https://idp.example
# IDP_AUDIENCE=ai-check-ui
# CORS_ALLOWED_ORIGINS=https://hse.internal.example

# --- development only ---
# ALLOW_INSECURE_LLM=true           # http:// to a non-loopback LLM host (docker compose stub)
