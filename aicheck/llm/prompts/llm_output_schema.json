{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "findings"
  ],
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_code",
          "target",
          "status",
          "evidence",
          "reason",
          "catalog_ids",
          "recommendation",
          "generated",
          "basis_refs",
          "confidence"
        ],
        "properties": {
          "rule_code": {
            "type": "string"
          },
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "enum": [
                  "measure",
                  "risk",
                  "flag",
                  "factor"
                ]
              },
              "section": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "row_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "field": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "status": {
            "enum": [
              "fail",
              "pass",
              "need_input",
              "not_applicable"
            ]
          },
          "evidence": {
            "type": "string",
            "maxLength": 500
          },
          "reason": {
            "type": "string",
            "maxLength": 300
          },
          "question": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200
          },
          "catalog_ids": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "recommendation": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1000
          },
          "generated": {
            "type": "boolean"
          },
          "basis_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9-]+:[0-9./)]+$"
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    }
  }
}